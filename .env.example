# =============================================================================
# Sistem ERP Akreditasi Faskes — LIPA MITRA NUSA
# Template kredensial project-level (root).
#
# File ini HANYA berisi placeholder untuk kredensial yang dipakai lintas
# backend/frontend. Salin ke .env dan isi nilai sesuai environment.
# Detail konfigurasi Laravel (APP_*, DB_*, MAIL_*, dll.) ada di
# `backend/.env.example` dan harus disalin ke `backend/.env`.
#
# JANGAN isi nilai asli di file ini. Gunakan secret manager atau .env lokal.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend Laravel — base URL (dipakai frontend untuk proxy / referer)
# -----------------------------------------------------------------------------
APP_NAME="Sistem ERP Akreditasi Faskes - LIPA MITRA NUSA"
APP_ENV=local
APP_URL=http://erp-akreditasi-faskes.test
BACKEND_API_URL=http://localhost:8000

# Frontend
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Database — PostgreSQL (Supabase)
# Salin connection string dashboard Supabase ke DB_URL, atau isi field terpisah.
# Aktifkan SSL: DB_SSLMODE=require (wajib untuk Supabase production).
# Backend membaca dari `backend/.env` (lihat `backend/.env.example`).
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_URL=
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require

# -----------------------------------------------------------------------------
# WhatsApp Business API (Meta Cloud API)
# Dipakai untuk: pengingat tagihan H-3/H-1 (NFR-1), notifikasi penugasan,
# fallback notifikasi (FR-2.7, FR-5.4a).
# -----------------------------------------------------------------------------
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# -----------------------------------------------------------------------------
# Payment Gateway (Virtual Account / QRIS)
# Dipakai untuk: verifikasi otomatis pembayaran Faskes (FR-2.3, FR-2.4),
# mendukung cicilan (FR-2.5), refund dengan approval (FR-2.8).
# Contoh provider: Midtrans, Xendit, Doku.
# -----------------------------------------------------------------------------
PAYMENT_GATEWAY_DRIVER=
PAYMENT_GATEWAY_SERVER_KEY=
PAYMENT_GATEWAY_CLIENT_KEY=
PAYMENT_GATEWAY_MERCHANT_ID=
PAYMENT_GATEWAY_ENV=sandbox
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Coretax DJP — ekspor bukti potong PPN & PPh 21 (FR-5.8, FR-5.9)
# -----------------------------------------------------------------------------
CORETAX_API_URL=
CORETAX_CLIENT_ID=
CORETAX_CLIENT_SECRET=
CORETAX_CERT_PATH=

# -----------------------------------------------------------------------------
# Tarif pajak (master data, FR-5.7) — fallback nilai awal
# Nilai final diubah oleh Keuangan via UI Modul Keuangan.
# -----------------------------------------------------------------------------
TAX_PPN_DEFAULT_PERCENT=11
TAX_PPH21_DEFAULT_PERCENT=2