#############################################################################
# TEMPLATE .env PRODUKSI — shared hosting Hostinger (hPanel)
#
# Salin file ini menjadi `backend/.env` DI SERVER, lalu isi nilainya.
# JANGAN commit .env yang sudah terisi (sudah di-ignore oleh .gitignore).
#
#   scp backend/.env.production.example u123456789@lipamitranusa.com:/home/.../app/backend/.env
#   ssh u123456789@lipamitranusa.com "cd /home/.../app/backend && php artisan key:generate"
#
# Semua nilai di bawah wajib diisi ulang untuk environment masing-masing.
#############################################################################

APP_NAME="Sistem ERP Akreditasi Faskes - LIPA MITRA NUSA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lipamitranusa.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Model yang dipakai sistem auth — harus AkunPengguna, bukan App\Models\User.
AUTH_MODEL="App\\Models\\AkunPengguna"
SANCTUM_TOKEN_EXPIRATION=480

# Host yang dianggap "stateful" oleh Sanctum (cookie-based auth).
# Frontend memakai Bearer token, tapi session dipakai untuk scoping lemma.
SANCTUM_STATEFUL_DOMAINS=lipamitranusa.com,www.lipamitranusa.com,localhost,localhost:5173,127.0.0.1:8000,127.0.0.1:5173

#############################################################################
# DATABASE
#
# Jalur A — Supabase (PostgreSQL), OPSI YANG DIREKOMENDASIKAN:
#   Salin "Connection string" dari Supabase Dashboard > Project Settings > Database.
#   Gunakan POOLER (Transaction mode, port 6543) agar koneksi dari shared
#   hosting tidak diblokir firewall Supabase.
#
# Jalur B — MySQL native Hostinger (hPanel > Databases):
#  _shared hosting tidak menyediakan driver pdo_pgsql_, jadi kalau ekstensi
#   PostgreSQL tidak tersedia di paket Anda, pakai MySQL. Kode aplikasi
#   sudah dibuat agnostic terhadap kedua driver.
#############################################################################

# --- Jalur A: Supabase / PostgreSQL ---
DB_CONNECTION=pgsql
DB_URL="postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"

# --- Jalur B: MySQL Hostinger (hapus DB_URL di atas, aktifkan baris ini) ---
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=u123456789_erp
# DB_USERNAME=u123456789_erp
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Tidak ada antrean asynchronous di aplikasi — everything diproses sinkron.
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@lipamitranusa.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

#############################################################################
# Cloudflare R2 Object Storage — attachment (bukti bayar, dokumen, laporan)
# Buat API Token: Cloudflare Dashboard > R2 > Manage R2 API Tokens
#############################################################################
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=erp-attachments
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_URL=https://pub.r2.dev

VITE_APP_NAME="${APP_NAME}"

#############################################################################
# INTEGRASI EKSTERNAL
#############################################################################

# --- WhatsApp Business API (Meta Cloud API) ---
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Payment Gateway (Midtrans) ---
PAYMENT_GATEWAY_DRIVER=fake
PAYMENT_GATEWAY_SERVER_KEY=
PAYMENT_GATEWAY_CLIENT_KEY=
PAYMENT_GATEWAY_MERCHANT_ID=
PAYMENT_GATEWAY_MODE=sandbox
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# --- Coretax DJP (ekspor bukti potong PPN & PPh 21) ---
CORETAX_API_URL=
CORETAX_CLIENT_ID=
CORETAX_CLIENT_SECRET=
CORETAX_CERT_PATH=

# --- Fallback tarif pajak ---
TAX_PPN_DEFAULT_PERCENT=11
TAX_PPH21_DEFAULT_PERCENT=2
