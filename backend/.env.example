APP_NAME="Sistem ERP Akreditasi Faskes - LIPA MITRA NUSA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://erp-akreditasi-faskes.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Model yang dipakai sistem auth (Laravel default: App\Models\User).
# Diset ke AkunPengguna agar Sanctum membaca kredensial dari tabel akun_pengguna
# (lihat FR-6.6 + NFR-3).
AUTH_MODEL="App\\Models\\AkunPengguna"

# Sanctum session timeout — menit sebelum token dianggap expired (NFR-3)
# Default 480 menit (8 jam kerja). Override sesuai kebijakan keamanan organisasi.
SANCTUM_TOKEN_EXPIRATION=480

# -----------------------------------------------------------------------------
# Database — PostgreSQL (Supabase)
# DB_CONNECTION=pgsql mengarahkan ke driver PostgreSQL bawaan Laravel.
# Untuk Supabase, gunakan DB_URL (connection string dari dashboard Supabase)
# atau isi DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD manual.
# Aktifkan SSL dengan DB_SSLMODE=require saat terhubung ke Supabase.
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
# DB_URL=
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Cloudflare R2 Object Storage — attachment storage
# Buat API Token: Cloudflare Dashboard > R2 > Manage R2 API Tokens
# -----------------------------------------------------------------------------
# CLOUDFLARE_R2_ACCESS_KEY_ID=    # Account ID (di Cloudflare Dashboard)
# CLOUDFLARE_R2_SECRET_ACCESS_KEY= # R2 API Token Secret
# CLOUDFLARE_R2_BUCKET=erp-attachments
# CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# CLOUDFLARE_R2_URL=https://pub.r2.dev

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# INTEGRASI EKSTERNAL — nilai asli jangan di-commit
# =============================================================================

# -----------------------------------------------------------------------------
# WhatsApp Business API (Meta Cloud API)
# Dipakai untuk: pengingat tagihan H-3/H-1 (NFR-1), notifikasi penugasan,
# fallback notifikasi saat WA down.
# -----------------------------------------------------------------------------
WHATSAPP_API_URL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# -----------------------------------------------------------------------------
# Payment Gateway (Virtual Account / QRIS)
# Dipakai untuk: verifikasi otomatis pembayaran Faskes (FR-2.3, FR-2.4).
# Contoh: Midtrans, Xendit, Doku. Sesuaikan nama variabel saat integrasi.
# -----------------------------------------------------------------------------
PAYMENT_GATEWAY_DRIVER=
PAYMENT_GATEWAY_SERVER_KEY=
PAYMENT_GATEWAY_CLIENT_KEY=
PAYMENT_GATEWAY_MERCHANT_ID=
PAYMENT_GATEWAY_ENV=sandbox
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Coretax DJP (ekspor bukti potong PPN & PPh 21 untuk upload pajak)
# Diputuskan pada PRD v2.4 / FR-5.9. Kredensial diberikan oleh DJP.
# -----------------------------------------------------------------------------
CORETAX_API_URL=
CORETAX_CLIENT_ID=
CORETAX_CLIENT_SECRET=
CORETAX_CERT_PATH=

# -----------------------------------------------------------------------------
# Pengaturan Modul Keuangan — tarif pajak (master data, FR-5.7)
# Disimpan sebagai setting dan dapat diubah via UI; nilai di sini hanya fallback.
# -----------------------------------------------------------------------------
TAX_PPN_DEFAULT_PERCENT=11
TAX_PPH21_DEFAULT_PERCENT=2